# ---------- build stage ----------
FROM gradle:8-jdk AS build
WORKDIR /workspace

COPY development .
RUN ./gradlew :gateway:bootJar -x test --no-daemon

# ---------- runtime stage ----------
FROM eclipse-temurin:21-jre-jammy AS runtime

RUN addgroup --system app && adduser --system --ingroup app app
USER app
WORKDIR /app

COPY --from=build /workspace/gateway/build/libs/*.jar app.jar

EXPOSE 8080
ENV JAVA_OPTS="-Xmx512m -Xms256m -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom"

ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]
